PORT=3000
ADMIN_KEY=change-this-to-a-long-random-string
SESSION_SECRET=change-this-to-a-long-random-string

# Optional payout automation. Leave disabled until a provider sandbox is tested.
PAYOUT_AUTOMATION_ENABLED=false
PAYOUT_PROVIDER=http
PAYOUT_API_URL=
PAYOUT_API_KEY=

# From your Supabase project: Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — only needed for the admin "Sync videos from YouTube" button.
# Get an API key from Google Cloud Console (enable "YouTube Data API v3"),
# and either your channel's ID (starts with UC...) or its @handle.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CHANNEL_HANDLE=
